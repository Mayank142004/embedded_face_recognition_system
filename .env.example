# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=face_attendance

# ── Google Cloud Storage ───────────────────────────────────
GCS_BUCKET_NAME=face-attendance-bucket
# Point this to your service-account key JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── MQTT Broker ────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=attendance/events

# ── Timezone (date boundaries for daily attendance) ────────
TIMEZONE=Asia/Kolkata

# ── Recognition tunables ──────────────────────────────────
DEBOUNCE_SECONDS=3.0
DEFAULT_CONFIDENCE_THRESHOLD=0.85

# ── Pi runtime tunables ────────────────────────────────────
# Capture/stream rate. The AI runs on its own schedule (AI_INTERVAL_SEC),
# so this only affects how smooth the video looks, not detection rate.
PI_TARGET_FPS=15

# Minimum seconds between AI passes (YOLO -> FaceNet -> line check). Floor is
# set by walking speed — a person must be sampled 2-3 times while below the
# attendance line, so do not raise this much above ~0.5s without retesting
# that attendance still fires reliably.
AI_INTERVAL_SEC=0.35

# Threads per TFLite interpreter. Pi 3/4 have 4 cores; leaving one free for
# capture, JPEG encode, MQTT and networking beats saturating all four.
TFLITE_NUM_THREADS=3

# Re-run FaceNet on an already-identified track after this many seconds.
FACE_RECONFIRM_SEC=10.0

# ── Outgoing stream (Pi -> server) ─────────────────────────
STREAM_WIDTH=480
STREAM_JPEG_QUALITY=50

# ── Motion gate ─────────────────────────────────────────────
# Skips the AI pipeline while the scene is static (e.g. empty corridor).
# This is the single largest thermal saving available on the Pi and costs
# no accuracy: the gate opens as soon as motion appears.
MOTION_GATE_ENABLED=1
MOTION_PIXEL_DELTA=12
MOTION_MIN_FRACTION=0.004
MOTION_KEEPALIVE_SEC=2.0

# ── Performance logging ────────────────────────────────────
PERF_LOG_INTERVAL=20.0
