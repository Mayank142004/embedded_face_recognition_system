# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=face_attendance

# ── Google Cloud Storage ───────────────────────────────────
GCS_BUCKET_NAME=face-attendance-bucket
# Point this to your service-account key JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── MQTT Broker ────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=attendance/events

# ── Timezone (date boundaries for daily attendance) ────────
TIMEZONE=Asia/Kolkata

# ── Recognition tunables ──────────────────────────────────
DEBOUNCE_SECONDS=3.0
DEFAULT_CONFIDENCE_THRESHOLD=0.85
